{
  "env": {
    "kind": "surrogate",
    "num_envs": 128,
    "max_episode_steps": 96,
    "device": "cpu",
    "progress_mode": "delta"
  },
  "ppo": {
    "rollouts": 32,
    "mini_batches": 4,
    "learning_epochs": 5,
    "learning_rate": 0.001
  },
  "actor": {"pre_mlp": [64], "lstm_hidden": 64, "post_mlp": [64], "sequence_length": 16, "initial_log_std": -0.5},
  "critic": {"pre_mlp": [64], "lstm_hidden": 64, "post_mlp": [64], "sequence_length": 16},
  "timesteps": 960,
  "checkpoint_every_updates": 10,
  "run_dir": "runs/vic_harvest/surrogate_smoke"
}
