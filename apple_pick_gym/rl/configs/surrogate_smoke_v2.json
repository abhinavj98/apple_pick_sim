{
  "env": {
    "kind": "surrogate",
    "num_envs": 128,
    "max_episode_steps": 96,
    "device": "cpu",
    "detach_criterion": "bend_pull",
    "detach_scale_range": [0.85, 1.15],
    "action_frame": "tool",
    "k_lin_max": 500.0,
    "realized_k_scale_range": [0.8, 1.2],
